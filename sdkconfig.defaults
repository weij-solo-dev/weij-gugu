# gugu — ESP32-S3R8 (M5Stack StopWatch): 16 MB QIO flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: big buffers (frame buffers, audio rings, TLS, JSON) live here (CLAUDE.md rule 9).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
# IDF's own tasks run our log hook and the Wi-Fi handlers: `mem` showed sys_evt at 528 B free of 2304 and tiT at 1008 of 3072.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# A crash leaves a core dump in the `coredump` partition; the next boot puts its summary (task, reason, backtrace) in
# the event log and erases it (board_crash_report). Reproducible builds: the same commit builds the same ELF on any
# Mac, so a backtrace from another device decodes against a local build (boot.json carries the ELF's SHA).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_APP_REPRODUCIBLE_BUILD=y

# Console over the native USB-Serial/JTAG (the board exposes no UART).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Networking / TLS: keep-alive connections, session tickets, certificate bundle.
# Wi-Fi buffers: fewer static ones, dynamic TX; LWIP/Wi-Fi allocations prefer PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
# The send buffer bounds how much of an upload is in flight: 16 KB over an ~80-100 ms round trip to the vendor capped a
# recording's upload at ~200 KB/s (2026-11-05 latency bench). 64 KB, the most without window scaling; the queued
# segments live in PSRAM (SPIRAM_TRY_ALLOCATE_WIFI_LWIP below).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# TLS buffers in PSRAM. The option is MBEDTLS_EXTERNAL_MEM_ALLOC: a misspelt name here is silently ignored, and with
# the internal default a call's three sessions (16 KB receive buffer each) ran internal RAM down to 16 KB and the
# TTS session's next read failed (PLAN.md 踩坑 32).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=65
# pairing mode's codes for the phone's camera (ui.c, the notice card)
CONFIG_LV_USE_QRCODE=y

# Pairing mode's captive portal answers a phone's every name, so its apps all come to the web server (3 sockets of its own
# and up to 7 connections), and the portal's DNS needs one more: the default 10 left none for a vendor test from the page.
CONFIG_LWIP_MAX_SOCKETS=16

# The speaker through a flash write (2026-11-09, the owner: the song sometimes stuck on a hiss). Writing flash turns
# the cache off, and an interrupt not in IRAM waits it out; the I2S one is what clears each played DMA buffer, so the
# DMA went round its ring replaying the last 90 ms until the write was done. IRAM-safe, the queued 90 ms play out and
# then silence, never a loop.
CONFIG_I2S_ISR_IRAM_SAFE=y
